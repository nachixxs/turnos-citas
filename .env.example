# Copiar a .env y completar con los valores reales.
# .env está en .gitignore y nunca se commitea.

# ─────────────────────────────────────────────────────────────
# Google Sheets — persistencia de turnos confirmados
# ─────────────────────────────────────────────────────────────

# Ruta absoluta al JSON de la service account. El archivo vive FUERA
# del repo a propósito (ver CODESTYLE, "Manejo de secretos").
GOOGLE_SHEETS_CREDENTIALS_PATH=C:\Users\<usuario>\.gcp\turnos-citas-sa.json

# ID del spreadsheet: el tramo entre /d/ y /edit en la URL de la Sheet.
# https://docs.google.com/spreadsheets/d/<ESTO_ES_EL_ID>/edit
SPREADSHEET_ID=

# Nombre de la pestaña dentro del spreadsheet donde viven los turnos.
SHEET_WORKSHEET=Turnos

# ─────────────────────────────────────────────────────────────
# Claude API — agente que decide qué tool llamar (CP2)
# ─────────────────────────────────────────────────────────────

# Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Configuración del negocio
# ─────────────────────────────────────────────────────────────

# Ruta al JSON de configuración del negocio (SPECS §5).
CONFIG_NEGOCIO_PATH=config/negocio.json

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API / Meta — orquestación con n8n (CP4)
# ─────────────────────────────────────────────────────────────

# Todo esto sale del panel de developers.facebook.com, de una app NUEVA:
# reusar la de otro proyecto comparte una sola URL de webhook y rompe el otro bot.

# App Dashboard → Configuración → Básica
META_APP_ID=
META_APP_SECRET=

# WhatsApp → Configuración de la API. El temporal del panel dura 24hs y cuando
# vence el síntoma no apunta al token: los envíos empiezan a fallar con un error
# de permisos. Usá uno de usuario del sistema, que no vence — se crea en
# business.facebook.com → Business settings → Users → System users, y hay que
# darle acceso a DOS activos: la app y la WhatsApp Account. Si falta el segundo,
# el token se genera igual y después tira 403 al tocar el WABA.
WHATSAPP_TOKEN=

# WhatsApp → Configuración de la API. Ojo: NO es el número de teléfono.
WHATSAPP_PHONE_ID=

# El id de la WhatsApp Business Account, en el mismo panel. Hace falta para
# crear el enlace `subscribed_apps`, que no aparece en ninguna pantalla y sin
# el cual no llega ningún mensaje.
WHATSAPP_WABA_ID=

# Secreto compartido que elegís vos, no lo emite Meta. Tiene que ser idéntico
# acá y en el panel de Meta al suscribir el webhook. `configurar_n8n.py` lo
# escribe dentro del workflow, así que si lo cambiás hay que reimportar el
# workflow, reiniciar n8n y volver a correr `configurar_meta.py`.
META_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Solo para testear sin Meta (CP4)
# ─────────────────────────────────────────────────────────────

# Vacío en uso normal: `configurar_n8n.py` apunta el workflow a la Graph API
# real. Poniéndole la dirección del doble local que levanta `verificar_n8n.py`
# (http://127.0.0.1:8099) el flujo entero corre sin tocar Meta.
GRAPH_API_BASE=
