# Copiar a .env y completar con los valores reales.
# .env está en .gitignore y nunca se commitea.

# ─────────────────────────────────────────────────────────────
# Google Sheets — persistencia de turnos confirmados
# ─────────────────────────────────────────────────────────────

# Ruta absoluta al JSON de la service account. El archivo vive FUERA
# del repo a propósito (ver CODESTYLE, "Manejo de secretos").
GOOGLE_SHEETS_CREDENTIALS_PATH=C:\Users\<usuario>\.gcp\turnos-citas-sa.json

# ID del spreadsheet: el tramo entre /d/ y /edit en la URL de la Sheet.
# https://docs.google.com/spreadsheets/d/<ESTO_ES_EL_ID>/edit
SPREADSHEET_ID=

# Nombre de la pestaña dentro del spreadsheet donde viven los turnos.
SHEET_WORKSHEET=Turnos

# ─────────────────────────────────────────────────────────────
# Claude API — agente que decide qué tool llamar (CP2)
# ─────────────────────────────────────────────────────────────

# Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Configuración del negocio
# ─────────────────────────────────────────────────────────────

# Ruta al JSON de configuración del negocio (SPECS §5).
CONFIG_NEGOCIO_PATH=config/negocio.json
